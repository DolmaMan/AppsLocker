<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/parent_color"
        app:title="Родительский режим"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card with device info -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_role_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Режим: Родительский"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tv_device_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ID устройства: загрузка..."
                        android:textSize="14sp"
                        android:gravity="center"
                        android:layout_marginBottom="8dp" />

                    <!-- Добавлен tv_auth_status -->
                    <TextView
                        android:id="@+id/tv_auth_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Статус аутентификации: проверка..."
                        android:textSize="14sp"
                        android:gravity="center"
                        android:textStyle="italic" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Section when user is authenticated -->
            <LinearLayout
                android:id="@+id/auth_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Управление устройствами"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Добавьте детские устройства в вашу семейную группу"
                            android:textSize="14sp"
                            android:textColor="@color/gray"
                            android:layout_marginBottom="16dp" />

                        <Button
                            android:id="@+id/btn_generate_qr"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Создать QR-код для связи"
                            android:textSize="16sp"
                            android:backgroundTint="@color/parent_color"
                            android:textColor="@color/white"
                            android:layout_marginBottom="8dp" />

                        <Button
                            android:id="@+id/btn_dashboard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Панель управления"
                            android:textSize="16sp"
                            android:backgroundTint="@color/green"
                            android:textColor="@color/white" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Section when user is NOT authenticated -->
            <LinearLayout
                android:id="@+id/no_auth_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Требуется аутентификация"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Для использования родительских функций требуется вход в аккаунт Google. Это обеспечит безопасность и синхронизацию данных."
                            android:textSize="14sp"
                            android:textColor="@color/gray"
                            android:layout_marginBottom="16dp" />

                        <!-- Добавлена кнопка btn_sign_in -->
                        <Button
                            android:id="@+id/btn_sign_in"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Войти через Google"
                            android:textSize="16sp"
                            android:backgroundTint="@color/parent_color"
                            android:textColor="@color/white" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Settings card (always visible) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Настройки"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp" />

                    <Button
                        android:id="@+id/btn_switch_role"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Сменить роль"
                        android:textSize="16sp"
                        android:backgroundTint="@color/orange"
                        android:textColor="@color/white"
                        android:layout_marginBottom="8dp" />


                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>